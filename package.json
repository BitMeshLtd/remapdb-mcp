{
  "name": "@remapdb/mcp",
  "version": "0.2.0",
  "description": "Stdio wrapper for the hosted Remapdb MCP server.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp": "./dist/index.js",
    "remapdb-mcp": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "remapdb",
    "mcp",
    "model-context-protocol",
    "stdio"
  ],
  "devDependencies": {
    "@types/node": "^20.19.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
